# Copy this file to .env.local and fill in the real values.
# Find them in the Supabase dashboard: Project Settings -> API Keys / Data API.
# .env.local is git-ignored. Never commit real keys.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (starts with sb_publishable_). The legacy "anon" key also works.
# Safe to expose: it can only do what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key (starts with sb_secret_). The legacy "service_role" key also works.
# SERVER ONLY. Bypasses Row Level Security. Used for marking answers.
# Never prefix with NEXT_PUBLIC_ and never import it in browser code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Optional: only needed to apply migrations from your computer with
# `npm run db:push`. Use the "Session pooler" connection string from
# the dashboard's Connect button, with your database password filled in.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
